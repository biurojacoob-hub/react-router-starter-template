// ============================================================
// Family Finance Academy — Prisma Schema
// PostgreSQL · UUID PKs · Soft delete · Full normalization
// ============================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────

enum UserRole {
  PARENT
  CHILD
  ADMIN
}

enum AgeGroup {
  EXPLORER   // 6–8
  LEARNER    // 9–11
  ACHIEVER   // 12–14
  MASTER     // 15–18
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum SubscriptionTier {
  FREE
  FAMILY
  FAMILY_PLUS
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  PAUSED
}

enum MissionStatus {
  AVAILABLE
  ACTIVE
  COMPLETED
  FAILED
  ABANDONED
}

enum BadgeCategory {
  EDUCATION
  FINANCIAL
  STREAK
  FAMILY
  AI
  SPECIAL
}

enum MessageRole {
  USER
  ASSISTANT
}

// ─────────────────────────────────────────────────────────────
// USER
// ─────────────────────────────────────────────────────────────

model User {
  id            String   @id @default(uuid()) @db.Uuid
  email         String   @unique
  emailVerified DateTime?
  firstName     String
  lastName      String
  passwordHash  String?
  image         String?
  role          UserRole @default(PARENT)

  // Onboarding
  onboardingDone Boolean @default(false)

  // Family membership
  familyId  String?  @db.Uuid
  family    Family?  @relation(fields: [familyId], references: [id])

  // Auth.js relations
  accounts Account[]
  sessions Session[]

  // Parent-specific relations
  childProfiles  ChildProfile[] @relation("ParentChildren")
  childProfileAs ChildProfile?  @relation("UserChildProfile")

  // Family invites sent by this user
  invitesSent FamilyInvite[]

  // Soft delete
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([familyId])
  @@index([deletedAt])
}

// ─────────────────────────────────────────────────────────────
// AUTH.JS — Account / Session / VerificationToken
// ─────────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @db.Uuid
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique
  userId       String   @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────────────────────
// FAMILY
// ─────────────────────────────────────────────────────────────

model Family {
  id               String           @id @default(uuid()) @db.Uuid
  name             String           @default("Moja Rodzina")
  subscriptionTier SubscriptionTier @default(FREE)
  onboardingDone   Boolean          @default(false)

  // Onboarding data
  childrenCount     Int?
  educationalGoals  String[]

  members       User[]
  childProfiles ChildProfile[]
  subscription  Subscription?
  invites       FamilyInvite[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([deletedAt])
}

// ─────────────────────────────────────────────────────────────
// FAMILY INVITE
// ─────────────────────────────────────────────────────────────

model FamilyInvite {
  id       String @id @default(uuid()) @db.Uuid
  familyId String @db.Uuid
  family   Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  invitedBy   String @db.Uuid
  invitedByUser User @relation(fields: [invitedBy], references: [id])

  code      String   @unique  // 8-char alphanumeric
  email     String?           // if targeted invite
  role      UserRole @default(CHILD)
  usedAt    DateTime?
  expiresAt DateTime

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([familyId])
  @@index([code])
  @@index([email])
  @@index([deletedAt])
}

// ─────────────────────────────────────────────────────────────
// CHILD PROFILE
// ─────────────────────────────────────────────────────────────

model ChildProfile {
  id       String   @id @default(uuid()) @db.Uuid
  userId   String?  @unique @db.Uuid  // null for demo/anonymous children
  user     User?    @relation("UserChildProfile", fields: [userId], references: [id])

  parentId String   @db.Uuid
  parent   User     @relation("ParentChildren", fields: [parentId], references: [id])

  familyId String   @db.Uuid
  family   Family   @relation(fields: [familyId], references: [id])

  firstName  String
  lastName   String
  birthYear  Int
  ageGroup   AgeGroup
  avatarUrl  String?

  // Gamification state
  xp            Int      @default(0)
  level         Int      @default(1)
  coins         Int      @default(0)
  streakDays    Int      @default(0)
  longestStreak Int      @default(0)
  lastActiveAt  DateTime?
  lastStreakDate DateTime? // date (midnight) of last streak-qualifying activity

  // Relations
  lessonProgress  LessonProgress[]
  missionProgress MissionProgress[]
  savingsGoals    SavingsGoal[]
  badges          ChildBadge[]
  aiConversations AIConversation[]
  skillProgress        SkillProgress[]
  learningPathSnapshots LearningPathSnapshot[]
  quizAttempts    QuizAttempt[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([parentId])
  @@index([familyId])
  @@index([userId])
  @@index([ageGroup])
  @@index([deletedAt])
}

// ─────────────────────────────────────────────────────────────
// COURSE
// ─────────────────────────────────────────────────────────────

model Course {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique     // "E1", "L2", "A3", "M1"
  title       String
  description String
  ageGroup    AgeGroup
  orderIndex  Int

  lessons Lesson[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([ageGroup])
  @@index([orderIndex])
  @@index([deletedAt])
}

// ─────────────────────────────────────────────────────────────
// LESSON
// ─────────────────────────────────────────────────────────────

model Lesson {
  id          String @id @default(uuid()) @db.Uuid
  courseId    String @db.Uuid
  course      Course @relation(fields: [courseId], references: [id])

  code            String  @unique   // "E1.1", "L2.3"
  title           String
  description     String
  orderIndex      Int
  durationMinutes Int
  xpReward        Int
  published       Boolean @default(false)

  contentBlocks ContentBlock[]
  quiz          Quiz?
  progress      LessonProgress[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([courseId])
  @@index([courseId, orderIndex])
  @@index([published])
  @@index([deletedAt])
}

// ─────────────────────────────────────────────────────────────
// CONTENT BLOCKS
// ─────────────────────────────────────────────────────────────

model ContentBlock {
  id       String @id @default(uuid()) @db.Uuid
  lessonId String @db.Uuid
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  type       ContentBlockType
  orderIndex Int
  content    Json             // shape depends on type

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lessonId, orderIndex])
}

enum ContentBlockType {
  TEXT
  IMAGE
  VIDEO
  TIP
  CHALLENGE
  SUMMARY
}

// ─────────────────────────────────────────────────────────────
// QUIZ
// ─────────────────────────────────────────────────────────────

model Quiz {
  id       String @id @default(uuid()) @db.Uuid
  lessonId String @unique @db.Uuid
  lesson   Lesson @relation(fields: [lessonId], references: [id])

  passingScore Int @default(60) // percentage required to pass

  questions QuizQuestion[]
  attempts  QuizAttempt[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model QuizQuestion {
  id     String @id @default(uuid()) @db.Uuid
  quizId String @db.Uuid
  quiz   Quiz   @relation(fields: [quizId], references: [id])

  orderIndex    Int
  question      String
  type          QuestionType @default(SINGLE_CHOICE)
  options       Json         // string[]
  correctAnswer Json         // string | string[] depending on type
  explanation   String
  difficulty    Difficulty   @default(MEDIUM)
  conceptTag    String?
  aiGenerated   Boolean      @default(false)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([quizId])
  @@index([quizId, orderIndex])
  @@index([deletedAt])
}

enum QuestionType {
  SINGLE_CHOICE
  MULTI_SELECT
  TRUE_FALSE
  DRAG_DROP
  CALCULATION
}

// ─────────────────────────────────────────────────────────────
// QUIZ ATTEMPT — per-submission record
// ─────────────────────────────────────────────────────────────

model QuizAttempt {
  id      String       @id @default(uuid()) @db.Uuid
  childId String       @db.Uuid
  child   ChildProfile @relation(fields: [childId], references: [id])
  quizId  String       @db.Uuid
  quiz    Quiz         @relation(fields: [quizId], references: [id])

  score      Int      // 0–100 percentage
  passed     Boolean
  answers    Json     // { questionId: string, answer: string | string[] }[]
  xpEarned   Int      @default(0)
  isPerfect  Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([childId, quizId])
  @@index([childId, createdAt(sort: Desc)])
}

// ─────────────────────────────────────────────────────────────
// MISSION
// ─────────────────────────────────────────────────────────────

model Mission {
  id          String     @id @default(uuid()) @db.Uuid
  title       String
  description String
  category    String
  difficulty  Difficulty @default(MEDIUM)
  durationDays Int
  xpReward    Int
  coinReward  Int
  ageMin      Int
  ageMax      Int
  aiGenerated Boolean    @default(false)
  published   Boolean    @default(false)

  progress MissionProgress[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([published])
  @@index([ageMin, ageMax])
  @@index([difficulty])
  @@index([deletedAt])
}

model MissionProgress {
  id        String   @id @default(uuid()) @db.Uuid
  childId   String   @db.Uuid
  child     ChildProfile @relation(fields: [childId], references: [id])
  missionId String   @db.Uuid
  mission   Mission  @relation(fields: [missionId], references: [id])

  status         MissionStatus @default(ACTIVE)
  parentVerified Boolean       @default(false)
  note           String?
  startedAt      DateTime      @default(now())
  completedAt    DateTime?

  checkIns MissionCheckIn[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([childId, missionId])
  @@index([childId])
  @@index([missionId])
  @@index([status])
  @@index([deletedAt])
}

model MissionCheckIn {
  id         String          @id @default(uuid()) @db.Uuid
  progressId String          @db.Uuid
  progress   MissionProgress @relation(fields: [progressId], references: [id])

  note        String?
  checkedInAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([progressId])
}

// ─────────────────────────────────────────────────────────────
// SAVINGS GOAL
// ─────────────────────────────────────────────────────────────

model SavingsGoal {
  id      String       @id @default(uuid()) @db.Uuid
  childId String       @db.Uuid
  child   ChildProfile @relation(fields: [childId], references: [id])

  title         String
  emoji         String   @default("🎯")
  targetAmount  Decimal  @db.Decimal(10, 2)
  currentAmount Decimal  @db.Decimal(10, 2) @default(0)
  deadline      DateTime?
  achieved      Boolean  @default(false)
  achievedAt    DateTime?

  contributions GoalContribution[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([childId])
  @@index([achieved])
  @@index([deletedAt])
}

model GoalContribution {
  id     String      @id @default(uuid()) @db.Uuid
  goalId String      @db.Uuid
  goal   SavingsGoal @relation(fields: [goalId], references: [id])

  amount    Decimal  @db.Decimal(10, 2)
  source    String   // "child" | "parent" | "reward"
  note      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([goalId])
}

// ─────────────────────────────────────────────────────────────
// PROGRESS — LESSON
// ─────────────────────────────────────────────────────────────

model LessonProgress {
  id       String       @id @default(uuid()) @db.Uuid
  childId  String       @db.Uuid
  child    ChildProfile @relation(fields: [childId], references: [id])
  lessonId String       @db.Uuid
  lesson   Lesson       @relation(fields: [lessonId], references: [id])

  completed   Boolean  @default(false)
  score       Int?     // 0–100, null if not yet quizzed
  attempts    Int      @default(0)
  xpEarned    Int      @default(0)
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([childId, lessonId])
  @@index([childId])
  @@index([lessonId])
  @@index([completed])
}

// ─────────────────────────────────────────────────────────────
// GAMIFICATION — BADGE
// ─────────────────────────────────────────────────────────────

model Badge {
  id          String        @id @default(uuid()) @db.Uuid
  code        String        @unique
  name        String
  description String
  emoji       String
  category    BadgeCategory
  xpReward    Int
  condition   Json          // { type: string, threshold: number }

  children ChildBadge[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([category])
  @@index([deletedAt])
}

model ChildBadge {
  id      String       @id @default(uuid()) @db.Uuid
  childId String       @db.Uuid
  child   ChildProfile @relation(fields: [childId], references: [id])
  badgeId String       @db.Uuid
  badge   Badge        @relation(fields: [badgeId], references: [id])

  earnedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([childId, badgeId])
  @@index([childId])
  @@index([badgeId])
}

// ─────────────────────────────────────────────────────────────
// AI CONVERSATION
// ─────────────────────────────────────────────────────────────

model AIConversation {
  id      String       @id @default(uuid()) @db.Uuid
  childId String       @db.Uuid
  child   ChildProfile @relation(fields: [childId], references: [id])

  title    String?   // optional summary, set after first exchange
  messages AIMessage[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([childId])
  @@index([childId, createdAt(sort: Desc)])
  @@index([deletedAt])
}

model AIMessage {
  id             String         @id @default(uuid()) @db.Uuid
  conversationId String         @db.Uuid
  conversation   AIConversation @relation(fields: [conversationId], references: [id])

  role    MessageRole
  content String
  tokens  Int?
  model   String?     // "claude-haiku-3-5" | "claude-sonnet-4-5"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([conversationId])
  @@index([conversationId, createdAt(sort: Asc)])
}

// ─────────────────────────────────────────────────────────────
// SUBSCRIPTION
// ─────────────────────────────────────────────────────────────

model Subscription {
  id       String @id @default(uuid()) @db.Uuid
  familyId String @unique @db.Uuid
  family   Family @relation(fields: [familyId], references: [id])

  plan                SubscriptionTier   @default(FREE)
  status              SubscriptionStatus @default(TRIALING)
  stripeCustomerId    String?            @unique
  stripeSubscriptionId String?           @unique
  stripePriceId       String?
  trialEndsAt         DateTime?
  currentPeriodStart  DateTime?
  currentPeriodEnd    DateTime?
  cancelAtPeriodEnd   Boolean            @default(false)
  renewalDate         DateTime?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status])
  @@index([plan])
  @@index([renewalDate])
  @@index([deletedAt])
}

// ─────────────────────────────────────────────────────────────
// CURRICULUM GRAPH — SKILL TREE
// ─────────────────────────────────────────────────────────────

model SkillProgress {
  id      String       @id @default(uuid()) @db.Uuid
  childId String       @db.Uuid
  child   ChildProfile @relation(fields: [childId], references: [id])

  skillId     String  // references ALL_SKILLS[].id (in-code graph, not FK)
  status      SkillStatus @default(LOCKED)
  xpEarned    Int         @default(0)
  attempts    Int         @default(0)
  lastScore   Int?        // 0-100
  startedAt   DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([childId, skillId])
  @@index([childId])
  @@index([childId, status])
  @@index([skillId])
}

model LearningPathSnapshot {
  id      String       @id @default(uuid()) @db.Uuid
  childId String       @db.Uuid
  child   ChildProfile @relation(fields: [childId], references: [id])

  currentSkillId    String?
  orderedSkillIds   String[]  // JSON-serialized ordered list
  completedCount    Int       @default(0)
  totalCount        Int       @default(0)
  estimatedWeeks    Int       @default(0)
  snapshotAt        DateTime  @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([childId])
  @@index([childId, snapshotAt(sort: Desc)])
}

enum SkillStatus {
  LOCKED
  UNLOCKED
  IN_PROGRESS
  COMPLETED
}
